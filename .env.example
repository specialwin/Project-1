# ---------------------------------------------------------------------------
# StockYa — ระบบสต๊อกยา
# ---------------------------------------------------------------------------

# NextAuth
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Airtable
# ---------------------------------------------------------------------------
# ถ้าเว้นว่างไว้ ระบบจะใช้ฐานข้อมูลตัวอย่างในหน่วยความจำ (Demo) อัตโนมัติ
# เพื่อให้ทดลองใช้งานได้ทันที โดยไม่ต้องตั้งค่า Airtable
#
# เมื่อต้องการใช้งานจริง ให้สร้าง Personal Access Token ที่
#   https://airtable.com/create/tokens
# ขอสิทธิ์ data.records:read, data.records:write กับ Base ที่ต้องการ
AIRTABLE_TOKEN=""
AIRTABLE_BASE_ID=""

# ชื่อตาราง (ปรับได้ ถ้าตั้งชื่อตารางใน Airtable ต่างจากค่าเริ่มต้น)
AIRTABLE_TABLE_USERS="Users"
AIRTABLE_TABLE_WAREHOUSES="Warehouses"
AIRTABLE_TABLE_DRUGS="Drugs"
AIRTABLE_TABLE_LOTS="Lots"
AIRTABLE_TABLE_TRANSACTIONS="Transactions"

# ---------------------------------------------------------------------------
# การแจ้งเตือนยาหมดอายุ
# ---------------------------------------------------------------------------
# จำนวนวันล่วงหน้าที่จะเตือนก่อนยาหมดอายุ
EXPIRY_WARN_DAYS="90"
EXPIRY_CRITICAL_DAYS="30"
